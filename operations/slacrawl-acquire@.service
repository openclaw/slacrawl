[Unit]
Description=Acquire PostgreSQL-owned Slack channel %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=slacrawl
Group=slacrawl
WorkingDirectory=/var/lib/slacrawl/%i
EnvironmentFile=/etc/slacrawl/acquire-%i.env
EnvironmentFile=/etc/slacrawl/provider-%i.env
ExecStart=/usr/bin/flock --nonblock --conflict-exit-code=75 /var/lib/slacrawl/%i/acquire.lock /usr/local/bin/slacrawl --config /etc/slacrawl/acquire-%i.toml --json acquire --origin ${SLACRAWL_ORIGIN} --archive ${SLACRAWL_ARCHIVE} --workspace ${SLACRAWL_WORKSPACE} --channel ${SLACRAWL_CHANNEL} --source ${SLACRAWL_SOURCE} --token-env SLACRAWL_PUBLISHER_TOKEN --max-pages 20 --timeout 90s
TimeoutStartSec=120s
TimeoutStopSec=30s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/slacrawl/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=100%
StandardOutput=journal
StandardError=journal
